# Backend
API_HOST=0.0.0.0
# Если порт 8000 занят другим сервисом (проверка: `ss -tlnp | grep :8000`),
# смени порт здесь, например: API_PORT=8010 — docker-compose подхватит сам.
API_PORT=8000
SCHEDULE_HORIZON_DAYS=30
SCHEDULE_SLOT_MINUTES=30
WAKE_START_HOUR=8
WAKE_END_HOUR=23
ML_RETRAIN_BATCH_SIZE=20
ML_OVERDUE_BONUS=10

# Frontend
VITE_API_URL=http://localhost:8000

# Database (phase 2)
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant_db
POSTGRES_PORT=5432

# Integrations
# Номер группы БГУИР для синхронизации расписания через iis.bsuir.by
IIS_GROUP_NUMBER=
# Дата начала семестра — от неё считаются учебные недели 1–4
SEMESTER_START_DATE=2026-09-01
# На сколько дней вперёд разворачивать занятия (28 = полный цикл недель)
IIS_HORIZON_DAYS=28
# Путь к SQLite-кэшу синхронизации
INTEGRATION_CACHE_PATH=data/integration_cache.db
# Google Calendar: положите credentials.json рядом с приложением и укажите путь
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=google_token.pickle
# Фоновая синхронизация (true/false)
INTEGRATIONS_BACKGROUND_SYNC_ENABLED=true
# Секрет для подписи токенов входа (замените на случайную строку)
AUTH_TOKEN_SECRET=dev-secret-change-me-in-production

# Локальная модель для распознавания задач из текста/фото (llama-server)
LOCAL_LLM_ENABLED=true
# Пусто = http://localhost:8080 для локального backend
# и http://llm:8080 для docker-compose (контейнер llm).
# Если API в Docker, а llama-server запущен на хосте:
# LOCAL_LLM_BASE_URL=http://host.docker.internal:8080
# LOCAL_LLM_BASE_URL=http://localhost:8080
LOCAL_LLM_MODEL=qwen3.5-4b
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_SECONDS=180
LOCAL_LLM_MAX_TOKENS=1024
LOCAL_LLM_TEMPERATURE=0.1
# Отключить «размышления» Qwen, чтобы модель сразу вернула JSON
LOCAL_LLM_DISABLE_THINKING=true
# Распознавание изображений (нужен mmproj в llama-server)
LOCAL_LLM_VISION_ENABLED=true
LOCAL_LLM_MAX_TEXT_KB=256
LOCAL_LLM_MAX_IMAGE_MB=10
# Сколько файлов можно загрузить для распознавания одной задачей/набором задач
LOCAL_LLM_MAX_FILES=3

# Какие GGUF-файлы брать из models/ (скачиваются `make models`)
LOCAL_LLM_MODEL_FILE=Qwen3.5-4B-UD-Q4_K_XL.gguf
LOCAL_LLM_MMPROJ_FILE=mmproj-F16.gguf
# Откуда скачивать (закреплённая ревизия Hugging Face)
LOCAL_LLM_HF_REPO=unsloth/Qwen3.5-4B-GGUF
LOCAL_LLM_HF_REVISION=e87f176479d0855a907a41277aca2f8ee7a09523

# Параметры scripts/run-llama-server.sh и контейнера llm
# (backend их не читает).
# 0.0.0.0 нужен для доступа из docker-compose; локально можно 127.0.0.1.
# LOCAL_LLM_HOST=0.0.0.0
# LOCAL_LLM_PORT=8080
# LOCAL_LLM_CTX_SIZE=16384
# LOCAL_LLM_GPU_LAYERS=0
# LOCAL_LLM_IMAGE_MIN_TOKENS=1024
# LOCAL_LLM_MODEL_PATH=models/Qwen3.5-4B-UD-Q4_K_XL.gguf
# LOCAL_LLM_MMPROJ_PATH=models/mmproj-F16.gguf
# LLAMA_SERVER_BIN=llama-server
